# Copy this file to `.env` and fill in values from your Supabase project
# (Supabase dashboard → Project Settings → API).
# Only the anon/public key goes here — it is safe to ship to the browser.
# Never put the service_role key in this file or any frontend code.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — error monitoring. Leave blank to disable Sentry entirely.
# Get a DSN from sentry.io → your project → Settings → Client Keys (DSN).
# The DSN is safe to expose in the browser.
VITE_SENTRY_DSN=
